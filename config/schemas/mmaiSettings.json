{
    "type" : "object",
    "$schema" : "http://json-schema.org/draft-04/schema",
    "title" : "MMAI settings format",
    "description" : "Format used to define settings for the MMAI mod",
    "additionalProperties" : false,
    "required" : [ "models", "fallback", "temperature", "seed" ],
    "properties" : {
        "$comment" : {
            "type" : "array",
            "default" : [],
            "items" : {
                "type" : "string"
            }
        },
        "models" : {
            "type" : "object",
            "additionalProperties" : false,
            "required" : [ "attacker", "defender" ],
            "properties" : {
                "attacker" : { "type" : "string" },
                "defender" : { "type" : "string" },
                "attacker.siege" : { "type" : "string" },
                "defender.siege" : { "type" : "string" }
            }
        },
        "fallback" : {
            "type" : "string",
            "default" : "BattleAI",
            "enum" : [ "BattleAI", "StupidAI" ]
        },
        "temperature" : {
            "type" : "number",
            "default" : 0.5
        },
        "seed" : {
            "type" : "number",
            "default" : 0
        },
        "delegateToBattleAI" : {
            "type" : "object",
            "additionalProperties" : false,
            "description" : "Unit types that are controlled by BattleAI logic instead of the model",
            "properties" : {
                "creatureSpells" : {
                    "type" : "boolean",
                    "default" : false,
                    "description" : "Units with active spellcasting ability ask BattleAI first and cast a spell if BattleAI would"
                },
                "healerMachines" : {
                    "type" : "boolean",
                    "default" : false,
                    "description" : "Any healing war machine heals like the First Aid Tent, not only the original one"
                }
            }
        }
    }
}
